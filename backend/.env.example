# ============================================================
# DocRetour Backend — Environment variables
# Copy to .env before running locally outside Docker.
# ============================================================

POSTGRES_DB=docretour_db
POSTGRES_USER=docretour_user
POSTGRES_PASSWORD=change_me_in_prod_db_password
DATABASE_URL=postgresql+asyncpg://docretour_user:change_me_in_prod_db_password@localhost:5432/docretour_db

REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_prod_minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_DOCUMENTS=docretour-documents

SECRET_KEY=change_me_in_prod_secret_key_minimum_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
DEBUG=true

APP_NAME=DocRetour
APP_VERSION=0.1.0

CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
