# Image de production (Render). Le dev local continue d'utiliser ./Dockerfile
# (avec --reload et volume monté). Ici : pas de reload, migrations au démarrage,
# port dynamique fourni par l'hébergeur ($PORT).
FROM python:3.12-slim

# Dépendances système d'asyncpg / cryptography
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chmod +x start.sh

ENV ENVIRONMENT=production
ENV PORT=8000
EXPOSE 8000

CMD ["./start.sh"]
